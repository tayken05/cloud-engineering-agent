        "collection_runs_source_counts_consistent": {
          "name": "collection_runs_source_counts_consistent",
          "value": "\n    \"collection_runs\".\"sources_succeeded\" + \"collection_runs\".\"sources_failed\" = \"collection_runs\".\"sources_attempted\" AND\n    cardinality(\"collection_runs\".\"processed_source_keys\") = \"collection_runs\".\"sources_attempted\" AND\n    cardinality(\"collection_runs\".\"failed_source_keys\") = \"collection_runs\".\"sources_failed\"\n  "
        },
        "collection_runs_lease_state": {
          "name": "collection_runs_lease_state",
          "value": "\n    (\"collection_runs\".\"status\" = 'running' AND \"collection_runs\".\"lease_token\" IS NOT NULL AND\n      \"collection_runs\".\"lease_expires_at\" IS NOT NULL AND \"collection_runs\".\"finished_at\" IS NULL) OR\n    (\"collection_runs\".\"status\" <> 'running' AND \"collection_runs\".\"lease_token\" IS NULL AND\n      \"collection_runs\".\"lease_expires_at\" IS NULL AND \"collection_runs\".\"finished_at\" IS NOT NULL)\n  "
        },
        "collection_runs_finished_after_start": {
          "name": "collection_runs_finished_after_start",
          "value": "\n    \"collection_runs\".\"finished_at\" IS NULL OR \"collection_runs\".\"finished_at\" >= \"collection_runs\".\"started_at\"\n  "
        }
