{
  "name": "cloud-engineering-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:shell": "node --test tests/shell.test.mjs",
    "test:sources": "node --conditions=react-server --test tests/sources-catalog.test.mjs tests/source-catalog-guard.test.mjs",
    "test:sources:http": "node --test tests/sources-http.test.mjs",
    "test:news": "node --conditions=react-server --test tests/news-ingestion.test.mjs tests/news-ingestion-guard.test.mjs",
    "test:news:http": "node --test tests/news-http.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test:db": "node --conditions=react-server --test tests/database.test.mjs tests/production-migration-guard.test.mjs",
    "db:seed:sources:development": "node --conditions=react-server scripts/source-catalog-seed.mjs --development",
    "db:seed:sources:production": "node --conditions=react-server scripts/source-catalog-seed.mjs --production",
    "db:ingest:news:development": "node --conditions=react-server scripts/news-ingestion.mjs --development",
    "db:ingest:news:production": "node --conditions=react-server scripts/news-ingestion.mjs --production",
    "db:migrate:production:preflight": "node scripts/production-migration.mjs --preflight",
    "db:migrate:production": "node scripts/production-migration.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
