# Server-only Neon connection URLs. Use the pooled URL for future application
# queries and reserve the direct URL for separately authorized migration work.
# Leave both empty in source control; builds and offline checks do not require them.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Production-only Vercel Cron authentication. Generate a random Secret in the
# Vercel project; never reuse a database credential or commit a real value.
CRON_SECRET=

# Managed Neon Auth server settings. COOKIE_SECRET must be a unique random
# server-only value of at least 32 characters. OWNER_AUTH_USER_ID is the exact
# stable managed-auth user ID allowed to operate private content routes.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_AUTH_USER_ID=

# Paid text generation is fail-closed. Keep disabled with a zero allowance until
# the owner separately approves billing and configures a server-only API key.
AI_GENERATION_ENABLED=false
AI_MONTHLY_BUDGET_USD=0
AI_TEXT_MODEL=gpt-6-luna
AI_INPUT_COST_PER_MILLION_USD=0.05
AI_OUTPUT_COST_PER_MILLION_USD=0.25
AI_MAX_RETRIES=1
AI_REQUEST_TIMEOUT_MS=45000
OPENAI_API_KEY=
